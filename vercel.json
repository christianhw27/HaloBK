{
  "rewrites": [
    {
      "source": "/berita/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|whatsapp|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Discordbot|discordbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
