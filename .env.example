# Konfigurasi Supabase (Dapatkan dari Project Settings > API di supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Konfigurasi Cloudinary Storage (Dapatkan dari dashboard.cloudinary.com)
# 1. Cloud Name: terlihat di pojok atas dashboard Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# 2. Upload Preset: dibuat di Settings > Upload > Upload presets > Mode: "Unsigned"
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# 3. Folder penyimpanan foto alumni di Cloudinary (opsional)
VITE_CLOUDINARY_FOLDER=halobk_alumni
